# what2eat — example env (no secrets). Copy to .env.local and fill values.
# Stack: ../../workspace-specs/3.tech-specs.md
# Design: 2eat-specs/5.tech-design.md §12
# Port registry (canonical): ../../workspace-specs/6.deployment-plan.md §0
#
# Local ports — do NOT reuse places-agent's PORT/PUBLIC_BASE_URL:
#   places-agent  PORT=3010  PUBLIC_BASE_URL=http://localhost:3010
#   what2eat      PORT=3020  PUBLIC_BASE_URL=http://localhost:3020
#   Agent upstream (MVP-2+): PLACES_AGENT_TARGET=local|prod (see places-agent section)

# =============================================================================
# App runtime
# =============================================================================
APP_NAME=what2eat
APP_ENV=local
# Do not set NODE_ENV here — Next.js sets it for dev/build/start.
PORT=3020

# =============================================================================
# Database (Prisma PostgreSQL — ADR-023)
# Local: `make up` starts postgres via docker-compose.dev.yml (host 5435).
# Prod: external Postgres on Aliyun 101.132.156.250 — DB name `what2eat` only.
# =============================================================================
DATABASE_URL=postgresql://what2eat:what2eat@localhost:5435/what2eat
TEST_DATABASE_URL=postgresql://what2eat:what2eat@localhost:5435/what2eat_test

# =============================================================================
# Session & public URLs
# =============================================================================
SESSION_SECRET=
PUBLIC_BASE_URL=http://localhost:3020
APP_URL=http://localhost:3020

# Next dev: comma-separated LAN IPs when testing from phone/laptop on same network
# Use the SAME LAN IP as places-agent ALLOWED_DEV_ORIGINS, but what2eat PUBLIC_BASE_URL stays :3020
ALLOWED_DEV_ORIGINS=

# =============================================================================
# places-agent (BFF server-to-server — MVP-2+)
# HTTP /v1/* on the same origin as MCP (/mcp). Switch stack with PLACES_AGENT_TARGET.
# Must be agent origin (:3010 local, places.agent-mate.ai prod), NOT what2eat :3020.
# Issue caller keys in places-agent admin (local and prod may differ).
# Restart Next dev after changing PLACES_AGENT_TARGET.
# =============================================================================
PLACES_AGENT_TARGET=local

PLACES_AGENT_BASE_URL_LOCAL=http://localhost:3010
PLACES_AGENT_CALLER_KEY_LOCAL=

PLACES_AGENT_BASE_URL_PROD=https://places.agent-mate.ai
PLACES_AGENT_CALLER_KEY_PROD=

# Optional legacy fallback if per-target vars are unset
PLACES_AGENT_BASE_URL=http://localhost:3010
PLACES_AGENT_CALLER_KEY=
PLACES_AGENT_TIMEOUT_MS=25000

# Default providers[] JSON when BFF does not infer from pin/locale (ADR-005)
W2E_DEFAULT_PROVIDERS=["GOOGLE_MAPS"]
W2E_ENRICH_TRIPADVISOR=true

# =============================================================================
# Quanzil LLM (OpenAI-compatible — product BFF, server-only)
# Never api.openai.com. Use max_completion_tokens (not max_tokens) on chat calls.
# MVP-3 list/place chat goes via places-agent POST /v1/chat; keep keys for
# future what2eat-owned LLM (e.g. preference-match copy) or opt-in BFF paths.
# =============================================================================
OPENAI_API_KEY=
OPENAI_HOST=quanzil.com
OPENAI_BASE_URL=https://quanzil.com/v1
OPENAI_CHAT_MODEL=gpt-5.4
OPENAI_KEY_MGMT_SITE=https://quanzil.com/console/token

# =============================================================================
# Email — Resend (password reset; MVP-1)
# =============================================================================
FEATURE_EMAIL=false
RESEND_API_KEY=
RESEND_HOST=api.resend.com
RESEND_BASE_URL=https://api.resend.com
RESEND_FROM_EMAIL=
RESEND_KEY_MGMT_SITE=https://resend.com/api-keys

# =============================================================================
# NOT used on what2eat (places-agent only — do not add here)
# AMAP_*  GOOGLE_MAPS_*  GMAPS_MCP_*  TRIPADVISOR_*  OPEN_METEO_*
# =============================================================================
